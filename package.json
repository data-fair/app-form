{
  "name": "@data-fair/app-form",
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "zellij --layout .zellij.kdl",
    "dev-server": "cross-env APP_URL=http://localhost:3000/app/ df-dev-server",
    "dev-app": "vite --port 3000",
    "build": "rm -rf dist && PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-form@${npm_package_version}/dist vite build",
    "build-types": "df-build-types && cp src/config/.type/resolved-schema.json public/config-schema.json",
    "prepublishOnly": "npm run build && npm run build-types",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky",
    "test": "playwright test --max-failures=1",
    "test-unit": "playwright test --project unit",
    "test-e2e": "APP_FORM_E2E_PORT=$((30000 + RANDOM % 10000)) playwright test --project e2e",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@data-fair/frame": "^0.18.6",
    "@data-fair/lib-common-types": "^1.22.0",
    "@data-fair/lib-utils": "^1.12.2",
    "@data-fair/lib-vue": "^1.30.1",
    "@data-fair/lib-vuetify": "^2.4.2",
    "@koumoul/vjsf": "^4.5.4",
    "dayjs": "^1.11.21",
    "ofetch": "^1.5.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vuetify": "^4.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/dev-server": "^2.3.4",
    "@data-fair/lib-types-builder": "^1.14.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  }
}
