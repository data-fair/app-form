{
  "name": "@data-fair/app-form",
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-server": "df-dev-server",
    "dev-app": "vite",
    "build": "rm -rf dist && PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-form@${npm_package_version}/dist vite build",
    "build-types": "df-build-types src/config",
    "prepublishOnly": "npm run build && npm run build-types",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "test": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "playwright test --project=unit",
    "test-e2e": "df-dev-env && dotenv -- playwright test --project=e2e",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@data-fair/frame": "^0.19.0",
    "@data-fair/lib-utils": "^1.15.0",
    "@data-fair/lib-vue": "^1.33.0",
    "@data-fair/lib-vuetify": "^2.5.4",
    "@koumoul/vjsf": "^4.8.0",
    "dayjs": "^1.11.23",
    "ofetch": "^1.5.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/dev-server": "^2.7.0",
    "@data-fair/lib-common-types": "^1.28.1",
    "@data-fair/lib-types-builder": "^1.14.6",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "husky": "^9.1.7",
    "neostandard": "^0.14.1",
    "sass-embedded": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
