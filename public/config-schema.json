{
  "type": "object",
  "x-exports": [
    "types"
  ],
  "required": ["datasets"],
  "allOf": [
    {
      "title": "Source de données",
      "properties": {
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": [
            {
              "title": "Jeu de données",
              "description": "Le jeu de données doit être éditable : les réponses soumises par les utilisateurs y seront ajoutées comme nouvelles lignes.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "href": { "type": "string" },
                "id": { "type": "string" },
                "title": { "type": "string" },
                "schema": { "type": "array" },
                "attachmentsAsImage": { "type": "boolean" },
                "userPermissions": { "type": "array" },
                "applicationKeyPermissions": {
                  "type": "object",
                  "const": {
                    "operations": [
                      "readSafeSchema",
                      "createLine"
                    ]
                  }
                }
              },
              "layout": {
                "getItems": {
                  "url": "api/v1/datasets?status=finalized&select=title,schema,attachmentsAsImage,userPermissions&rest=true&owner=${context.owner.type}:${context.owner.id}&size=50",
                  "qSearchParam": "q",
                  "itemKey": "data.href",
                  "itemTitle": "data.title",
                  "itemsResults": "data.results"
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "Rendu",
      "properties": {
        "density": {
          "title": "Densité",
          "description": "Hauteur et espacement des champs du formulaire. Ne change pas la taille du texte.",
          "type": "string",
          "default": "default",
          "oneOf": [
            { "const": "default", "title": "Aérée" },
            { "const": "comfortable", "title": "Normale" },
            { "const": "compact", "title": "Compacte" }
          ],
          "layout": { "cols": { "xs": 12, "sm": 6 } }
        },
        "layout": {
          "title": "Rendu des groupes",
          "description": "Manière d'afficher les groupes de champs définis dans le schéma du jeu de données. Sans groupe, cette option n'a pas d'effet.",
          "type": "string",
          "default": "sections",
          "oneOf": [
            { "const": "sections", "title": "Sections" },
            { "const": "tabs", "title": "Onglets" },
            { "const": "vertical-tabs", "title": "Onglets empilés" },
            { "const": "expansion-panels", "title": "Accordéon" },
            { "const": "none", "title": "Aucun" }
          ],
          "layout": { "cols": { "xs": 12, "sm": 6 } }
        },
        "groups": {
          "title": "Regroupement des champs",
          "description": "Avec « Par groupe », toutes les colonnes d'un même groupe sont réunies dans un bloc qui porte le nom du groupe, même si elles ne se suivent pas dans le schéma du jeu de données. Les colonnes sans groupe restent en dehors de ces blocs. Avec « Ordre des colonnes », les champs suivent l'ordre du schéma et les groupes sont ignorés.",
          "type": "string",
          "default": "all",
          "oneOf": [
            { "const": "all", "title": "Par groupe" },
            { "const": "none", "title": "Ordre des colonnes" }
          ],
          "layout": { "cols": { "xs": 12, "sm": 6 } }
        },
        "variant": {
          "title": "Style des éléments",
          "description": "Style Vuetify appliqué aux champs de saisie du formulaire.",
          "type": "string",
          "default": "filled",
          "oneOf": [
            { "const": "outlined", "title": "Bordure" },
            { "const": "plain", "title": "Rien" },
            { "const": "underlined", "title": "Souligné" },
            { "const": "filled", "title": "Rempli" },
            { "const": "solo", "title": "Solo" },
            { "const": "solo-inverted", "title": "Solo inversé" },
            { "const": "solo-filled", "title": "Solo rempli" }
          ],
          "layout": { "cols": { "xs": 12, "sm": 6 } }
        },
        "submitMessage": {
          "title": "Message après envoi",
          "description": "Message affiché à l'utilisateur après l'envoi réussi du formulaire.",
          "type": "string",
          "layout": "textarea",
          "default": "Merci, votre réponse a bien été enregistrée !"
        }
      }
    }
  ]
}
